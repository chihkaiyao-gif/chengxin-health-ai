# Chengxin Health AI environment template

# App identity
NEXT_PUBLIC_APP_NAME=Chengxin Health AI
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_VERSION=0.1.0

# Demo mode
# true: local demo fallback is allowed when Supabase is not configured.
# false: Supabase is required; missing Supabase env should fail loudly.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-supabase-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-server-only-secret-key

# Supabase Storage buckets
SUPABASE_STORAGE_MEAL_PHOTOS_BUCKET=meal-photos
SUPABASE_STORAGE_INBODY_SCANS_BUCKET=inbody-scans
SUPABASE_STORAGE_PUBLIC_ASSETS_BUCKET=public-assets

# AI Gateway
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Optional LINE provider skeleton
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Optional email provider skeleton
EMAIL_PROVIDER=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional SMS provider skeleton
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional production observability
SENTRY_DSN=
LOG_LEVEL=info
